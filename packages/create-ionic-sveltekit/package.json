{
  "name": "create-ionic-sveltekit",
  "version": "0.5.0",
  "description": "A CLI tool to set up a new project using SvelteKit with Ionic.",
  "keywords": [
    "ionic",
    "svelte",
    "sveltekit",
    "CLI",
    "bootstrap"
  ],
  "homepage": "https://github.com/briznad/ionic-sveltekit/packages/create-ionic-sveltekit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/briznad/ionic-sveltekit",
    "directory": "packages/create-ionic-sveltekit/"
  },
  "license": "MIT",
  "author": "Brad Mallow",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "create-ionic-sveltekit": "./src/index.js"
  },
  "files": [
    "src/**"
  ],
  "engines": {
    "node": ">=14.16"
  },
  "scripts": {
    "dev": "node src/index.js",
    "long": "node src/index.js --types=typescript --prettier --eslint --playwright=false -f svelte-kit --ionicons=false",
    "pub:beta": "npm publish --tag beta",
    "pub:next": "npm publish --tag next",
    "pub:release": "npm publish",
    "release": "npm publish",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "create-svelte": "^6.3.5",
    "fs-extra": "^10.1.0",
    "ip": "^1.1.8",
    "kleur": "^4.1.5",
    "mri": "^1.2.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "bumpp": "^8.2.1",
    "eslint": "^8.28.0",
    "standard-version": "^9.5.0",
    "svelte": "^4.2.7"
  }
}
